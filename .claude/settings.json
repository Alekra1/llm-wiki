{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "touch \"/tmp/.cc-wiki-$(pwd | cksum | awk '{print $1}')\""
          }
        ]
      }
    ],
    "Stop": [],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash wiki/scripts/session-end-capture.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(wiki/**)",
      "Edit(wiki/**)",
      "Write(wiki/**)",
      "Bash(grep * wiki/**)",
      "Bash(grep \"^*\" wiki/**)",
      "Bash(find wiki/**)",
      "Bash(cat >> wiki/**)",
      "Bash(git log *)",
      "Bash(wiki/scripts/*)",
      "Bash(bash wiki/scripts/*)"
    ]
  }
}
